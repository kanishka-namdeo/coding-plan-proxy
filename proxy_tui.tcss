#dashboard {
    layout: vertical;
    height: 1fr;
}

#metrics-panel {
    width: 50%;
    border: tall green;
    padding: 0 1;
    margin: 0;
}

#log-panel {
    width: 50%;
    border: tall blue;
    padding: 0 1;
    margin: 0;
}

.panel-title {
    text-style: bold;
    color: $primary;
    dock: top;
    padding: 0 1;
    height: 1;
}

.spacer {
    height: 1;
}

#status-indicator {
    dock: top;
    padding: 0 1;
    text-style: bold;
    height: 1;
}

#status-indicator.status-running {
    color: $success;
}

#status-indicator.status-stopped {
    color: $error;
}

#error-banner {
    dock: top;
    padding: 0 1;
    color: $error;
    background: $error 10%;
    height: auto;
    max-height: 2;
}

#live-log {
    height: 1fr;
}

DataTable {
    height: auto;
}

/* Tabbed content layout */
TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
}

/* Metrics tab */
#metrics-tab-content {
    height: 1fr;
}

#sparkline-row {
    height: auto;
    margin: 1 0;
}

.sparkline-label {
    width: 10;
    text-style: bold;
    color: $primary;
}

Sparkline {
    height: 5;
}

#rpm-sparkline {
    width: 1fr;
}

#tpm-sparkline {
    width: 1fr;
}

#queue-sparkline {
    width: 1fr;
}

.derived-panel {
    height: auto;
    padding: 0 1;
    margin: 1 0;
    border: round $primary;
}

.poll-error {
    height: auto;
    padding: 0 1;
    color: $error;
    background: $error 10%;
}

.poll-error:empty {
    display: none;
}

/* Logs tab */
#logs-tab-content {
    height: 1fr;
}

#filter-bar {
    height: auto;
    margin: 0 0 1 0;
}

#log-filter {
    width: 2fr;
}

#log-level-filter {
    width: 1fr;
    margin: 0 1 0 1;
}

#clear-logs-btn {
    width: auto;
}

#live-log-full {
    height: 1fr;
}

/* Models tab */
#model-usage-table {
    height: 1fr;
}

/* Config tab */
#config-table {
    height: 1fr;
}

#config-tab-content {
    height: 1fr;
}

#config-controls {
    height: auto;
    margin: 0 0 1 0;
}

#config-filter {
    width: 1fr;
}

/* Alert badge */
.alert-badge {
    dock: top;
    padding: 0 1;
    color: $warning;
    height: 1;
}

.alert-badge.alert-active {
    color: $error;
    background: $error 20%;
    text-style: bold;
}

/* Models tab */
#models-tab-content {
    height: 1fr;
}

#model-controls {
    height: auto;
    margin: 0 0 1 0;
}

#model-filter {
    width: 1fr;
    margin: 0 1 0 0;
}

#model-sort {
    width: 1fr;
}

/* Log controls */
#log-controls-bar {
    height: auto;
    margin: 0 0 1 0;
}

#pause-logs-btn {
    width: auto;
}

#export-logs-btn {
    width: auto;
}

#autoscroll-btn {
    width: auto;
}

.entry-count {
    width: 1fr;
    content-align: right middle;
    padding: 0 1;
    color: $primary;
}

/* Time range filter */
#log-time-range {
    width: 1fr;
    margin: 0 1 0 1;
}

/* Latency histogram */
.histogram-panel {
    height: auto;
    padding: 0 1;
    margin: 1 0;
    border: round $success;
}

.histogram-panel:empty {
    display: none;
}
