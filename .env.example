# Required
DASHSCOPE_API_KEY=your_api_key_here

# Network Configuration
DASHSCOPE_PROXY_HOST=127.0.0.1
DASHSCOPE_PROXY_PORT=8899
TARGET_BASE=https://coding-intl.dashscope.aliyuncs.com/v1

# Timeouts (seconds)
UPSTREAM_TIMEOUT_TOTAL=300
UPSTREAM_TIMEOUT_CONNECT=10

# Connection Limits
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_HOST=50
MAX_BODY_SIZE=52428800
MAX_STREAM_BUFFER=52428800
# Cap for a single upstream response/error body read into memory (bytes)
# UPSTREAM_MAX_BODY_SIZE=52428800

# Retry Configuration
MAX_5XX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_BUFFER_SIZE=2000

# Rate Limiting (optional overrides)
# PROXY_RPM_LIMIT=14
# PROXY_TPM_LIMIT=4000000
# PROXY_SAFETY_FACTOR=0.8

# Secondary Provider (MIMO Coding Plan) - Optional
# When configured, requests to mimo models will be routed to this provider
# with separate rate limiting and analytics
MIMO_CODING_PLAN_API_KEY=your_mimo_api_key_here
MIMO_CODING_PLAN_TARGET_BASE=https://api.mimo.com/v1

# Supported MIMO models:
# mimo-v2.5-pro

# Secondary Provider Rate Limits (optional overrides)
# SECONDARY_RPM_LIMIT=10
# SECONDARY_TPM_LIMIT=4000000
# SECONDARY_SAFETY_FACTOR=0.8
# SECONDARY_REQUESTS_PER_5H=6000
# SECONDARY_REQUESTS_PER_WEEK=45000
# SECONDARY_REQUESTS_PER_MONTH=90000
# SECONDARY_MAX_QUEUE_SIZE=500
# SECONDARY_MAX_RETRIES=40
# SECONDARY_BASE_BACKOFF=1.0

# Tertiary Provider (OpenLux) - Optional
# When configured, requests to OpenLux models will be routed to this provider
# with separate rate limiting and analytics
OPENLUX_API_KEY=your_openlux_api_key_here
OPENLUX_TARGET_BASE=https://api.openlux.ai/v1

# Supported OpenLux models:
# gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna, gemini-3.7-flash, gemini-3.8-flash,
# grok-4.6, MiniMax-M3, qwen3.8-max, qwen3.8-max-0902, mimo-v2.5, glm-5.3-flash

# Tertiary Provider Rate Limits (optional overrides, defaults are independent)
# Defaults: RPM=40, TPM=6M, 5h=3000, week=20000, month=50000, queue=200, retries=20
# TERTIARY_RPM_LIMIT=40
# TERTIARY_TPM_LIMIT=6000000
# TERTIARY_SAFETY_FACTOR=0.8
# TERTIARY_REQUESTS_PER_5H=3000
# TERTIARY_REQUESTS_PER_WEEK=20000
# TERTIARY_REQUESTS_PER_MONTH=50000
# TERTIARY_MAX_QUEUE_SIZE=200
# TERTIARY_MAX_RETRIES=20
# TERTIARY_BASE_BACKOFF=1.0

# Quaternary Provider (ARK / BytePlus) - Optional
# When configured, requests to ARK models will be routed to this provider
# with separate rate limiting and analytics
MODEL_ARK_API_KEY=your_ark_api_key_here
MODEL_ARK_TARGET_BASE=https://ark.ap-southeast.bytepluses.com/api/coding/v3

# Supported ARK models:
# glm-5.2, glm-5.1

# Quaternary Provider Rate Limits (optional overrides)
# Defaults: RPM=40, TPM=6M, 5h=3000, week=20000, month=50000, queue=200, retries=20
# QUATERNARY_RPM_LIMIT=40
# QUATERNARY_TPM_LIMIT=6000000
# QUATERNARY_SAFETY_FACTOR=0.8
# QUATERNARY_REQUESTS_PER_5H=3000
# QUATERNARY_REQUESTS_PER_WEEK=20000
# QUATERNARY_REQUESTS_PER_MONTH=50000
# QUATERNARY_MAX_QUEUE_SIZE=200
# QUATERNARY_MAX_RETRIES=20
# QUATERNARY_BASE_BACKOFF=1.0

# Quinary Provider (Meta AI / Muse Spark) - Optional
# When configured, requests to Muse Spark models will be routed to this provider
# with separate rate limiting and analytics
META_AI_API_KEY=your_meta_ai_api_key_here
META_AI_TARGET_BASE=https://api.meta.ai/v1

# Supported Meta AI models:
# muse-spark-1.3, muse-spark-1.3-contributor

# Quinary Provider Rate Limits (optional overrides)
# Defaults: RPM=3000, TPM=4M, 5h=10000, week=50000, month=100000, queue=500, retries=20
# QUINARY_RPM_LIMIT=3000
# QUINARY_TPM_LIMIT=4000000
# QUINARY_SAFETY_FACTOR=0.8
# QUINARY_REQUESTS_PER_5H=10000
# QUINARY_REQUESTS_PER_WEEK=50000
# QUINARY_REQUESTS_PER_MONTH=100000
# QUINARY_MAX_QUEUE_SIZE=500
# QUINARY_MAX_RETRIES=20
# QUINARY_BASE_BACKOFF=0.5

# Senary Provider (DeepSeek) - Optional
# When configured, requests to DeepSeek models will be routed to this provider
# with separate rate limiting and analytics
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_TARGET_BASE=https://api.deepseek.com

# Supported DeepSeek models:
# deepseek-flash

# Senary Provider Rate Limits (optional overrides)
# Defaults: RPM=60, TPM=4M, 5h=10000, week=50000, month=100000, queue=500, retries=20
# SENARY_RPM_LIMIT=60
# SENARY_TPM_LIMIT=4000000
# SENARY_SAFETY_FACTOR=0.8
# SENARY_REQUESTS_PER_5H=10000
# SENARY_REQUESTS_PER_WEEK=50000
# SENARY_REQUESTS_PER_MONTH=100000
# SENARY_MAX_QUEUE_SIZE=500
# SENARY_MAX_RETRIES=20
# SENARY_BASE_BACKOFF=0.5

# ============================================================================
# Septenary Provider (GLM) - Optional
# ============================================================================
# When configured, requests to GLM models will be routed to this provider
# with separate rate limiting and analytics
GLM_API_KEY=your_glm_api_key_here
GLM_TARGET_BASE=https://api.z.ai/api/paas/v4

# Supported GLM models:
# glm-5.3, glm-5.2, glm-5.1, glm-5-turbo, glm-5, glm-4.7, glm-4.6, glm-4.5, glm-4.5-air

# Septenary Provider Rate Limits (optional overrides)
# Defaults: RPM=60, TPM=4M, 5h=10000, week=50000, month=100000, queue=500, retries=20
# SEPTENARY_RPM_LIMIT=60
# SEPTENARY_TPM_LIMIT=4000000
# SEPTENARY_SAFETY_FACTOR=0.8
# SEPTENARY_REQUESTS_PER_5H=10000
# SEPTENARY_REQUESTS_PER_WEEK=50000
# SEPTENARY_REQUESTS_PER_MONTH=100000
# SEPTENARY_MAX_QUEUE_SIZE=500
# SEPTENARY_MAX_RETRIES=20
# SEPTENARY_BASE_BACKOFF=0.5

# ============================================================================
# Octonary / Nonary / Decenary Providers (Agnes AI Token Plan) - Optional
# ============================================================================
# One Agnes AI Token Plan key serves all three modalities, but each modality is
# registered as its own provider entry so its own upstream RPM cap is enforced
# by a separate rate limiter:
#   octonary "Agnes Text"  = agnes-3.0-flash        pin: agnes
#   nonary   "Agnes Image" = agnes-image-2.1-flash  pin: agnes-image
#   decenary "Agnes Video" = agnes-video-2.5-flash  pin: agnes-video
# The canonical ordinal name also works as a pin. Agnes model IDs are unique
# across all providers, so a bare model name routes without a pin.
AGNES_API_KEY=your_agnes_api_key_here
AGNES_TARGET_BASE=https://apihub.agnes-ai.com/v1

# Supported Agnes AI models:
# agnes-3.0-flash, agnes-image-2.1-flash, agnes-video-2.5-flash

# Octonary Provider Rate Limits (Agnes Text, optional overrides)
# Defaults: RPM=1000, TPM=4M, queue=500, retries=40, backoff=1.0
# The Token Plan also meters text per 5 hours and per week; this proxy's limiter
# is a 60-second sliding window, so 1000 is the burst cap rather than the
# sustained rate. Set OCTONARY_RPM_LIMIT to your plan's sustained rate to
# preserve the longer-window budget: Starter (1,500 / 5h) ~= 5/min,
# Plus (7,500 / 5h) ~= 25/min, Pro (30,000 / 5h) ~= 100/min.
# OCTONARY_RPM_LIMIT=1000
# OCTONARY_TPM_LIMIT=4000000
# OCTONARY_SAFETY_FACTOR=0.8
# OCTONARY_MAX_QUEUE_SIZE=500
# OCTONARY_MAX_RETRIES=40
# OCTONARY_BASE_BACKOFF=1.0

# Nonary Provider Rate Limits (Agnes Image, optional overrides)
# Defaults: RPM=120, TPM=4M, queue=200, retries=20, backoff=1.0
# RPM is taken from the 1K/2K size tiers. The 3K/4K tiers allow only 2 RPM
# upstream and surface as 429s, which the existing retry path absorbs. The
# Token Plan's per-day image quota is not enforced here.
# NONARY_RPM_LIMIT=120
# NONARY_TPM_LIMIT=4000000
# NONARY_SAFETY_FACTOR=0.8
# NONARY_MAX_QUEUE_SIZE=200
# NONARY_MAX_RETRIES=20
# NONARY_BASE_BACKOFF=1.0

# Decenary Provider Rate Limits (Agnes Video, optional overrides)
# Defaults: RPM=6, TPM=4M, queue=200, retries=20, backoff=1.0
# Only the create-task POST /v1/videos is proxyable. Poll the result directly
# against Agnes, never through the proxy:
#   GET https://apihub.agnes-ai.com/agnesapi?video_id=<ID>&model_name=agnes-video-2.5-flash
# Routing keys off the model name in the request body (a GET has none), and the
# proxy always re-inserts the API version into the path (/agnesapi would become
# /v1/agnesapi). The Token Plan's per-day video-second quota is not enforced here.
# DECENARY_RPM_LIMIT=6
# DECENARY_TPM_LIMIT=4000000
# DECENARY_SAFETY_FACTOR=0.8
# DECENARY_MAX_QUEUE_SIZE=200
# DECENARY_MAX_RETRIES=20
# DECENARY_BASE_BACKOFF=1.0

# Agnes image responses: prefer extra_body.response_format="url" over inline
# b64_json. UPSTREAM_MAX_BODY_SIZE caps one upstream body (default 50 MB) and a
# large base64 image can exceed it. Raise UPSTREAM_TIMEOUT_TOTAL above its 300s
# default for 4K generation, where Agnes recommends up to 360s.

# Optional: overlap failover try-order (canonical provider names, comma-separated).
# Unset = decenary,nonary,octonary,septenary,senary,quinary,quaternary,tertiary,secondary,primary.
# MODEL_FALLBACK_ORDER=openlux,ark,dashscope